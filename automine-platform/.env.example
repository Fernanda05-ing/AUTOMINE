# ===================================================================
# AUTOMINE - configuracion del servidor. Copie como .env y complete.
# NO suba el archivo .env a GitHub (ya esta en .gitignore).
# Para generar claves aleatorias:  openssl rand -base64 36
# ===================================================================

# --- Dominio (debe apuntar con un registro A a la IP del servidor) ---
# Para incluir www:  DOMAIN=automine.com.co, www.automine.com.co
DOMAIN=automine.com.co
# Direccion publica (enlaces de correos y validacion de certificados)
PUBLIC_URL=https://automine.com.co

# --- Modo: production (sin datos de prueba) o demo (permite DEMO_DATA=true) ---
APP_ENV=production
DEMO_DATA=false

# --- Base de datos ---
DB_PASSWORD=CAMBIE-ESTA-CLAVE
DB_ROOT_PASSWORD=CAMBIE-ESTA-OTRA-CLAVE

# --- Seguridad: clave de firma de sesiones (32+ caracteres aleatorios) ---
JWT_SECRET=CAMBIE-POR-UNA-CADENA-LARGA-Y-ALEATORIA

# --- Administrador inicial (se crea solo la primera vez; debera cambiar la clave al entrar) ---
ADMIN_EMAIL=admin@automine.com.co
ADMIN_PASSWORD=CAMBIE-ESTA-CLAVE-1

# --- Iniciar sesion con Google (opcional): ID de cliente OAuth de Google Cloud (no es secreto) ---
GOOGLE_CLIENT_ID=

# --- Correo (Gmail): MAIL_USERNAME = su cuenta, MAIL_PASSWORD = contrasena de aplicacion de 16 letras ---
MAIL_USERNAME=
MAIL_PASSWORD=
# Si el proveedor del servidor bloquea el puerto 587, use 465 con SSL:
# MAIL_PORT=465
# MAIL_SSL=true
# MAIL_STARTTLS=false

# --- Datos de la empresa (certificados, desprendibles y correos) ---
COMPANY_NAME=AUTOMINE S.A.S.
COMPANY_NIT=900.123.456-7
COMPANY_CITY=Medellín, Antioquia

# --- Respaldos ---
BACKUP_RETENTION_DAYS=14
